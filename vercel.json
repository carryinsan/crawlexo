{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/search.js": { "maxDuration": 60 },
    "api/retrieve.js": { "maxDuration": 60 },
    "api/extract.rs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/crawl", "destination": "/api/extract" },
    { "source": "/api/crawler", "destination": "/api/search" }
  ]
}
